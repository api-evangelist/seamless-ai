{
  "info": {
    "name": "Seamless.AI OAuth API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Generated by API Evangelist on 2026-08-14 from openapi/seamless-ai-oauth-api-openapi.yml, itself split from the provider-published OpenAPI at https://docs.seamless.ai/openapi.json."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.seamless.ai/api/client/v1"
    },
    {
      "key": "apiKey",
      "value": "REDACTED_SEAMLESS_API_KEY"
    }
  ],
  "item": [
    {
      "name": "Get an access token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Token",
            "value": "{{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/oauth/accessToken",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "oauth",
            "accessToken"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"grant_type\": \"authorization_code\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}