{
  "info": {
    "name": "Seamless.AI Company Research API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Generated by API Evangelist on 2026-08-14 from openapi/seamless-ai-company-research-api-openapi.yml, itself split from the provider-published OpenAPI at https://docs.seamless.ai/openapi.json."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.seamless.ai/api/client/v1"
    },
    {
      "key": "apiKey",
      "value": "REDACTED_SEAMLESS_API_KEY"
    }
  ],
  "item": [
    {
      "name": "Research companies",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Token",
            "value": "{{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/companies/research",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "companies",
            "research"
          ]
        },
        "description": "Research companies by search result IDs from `/search/companies` and/or direct company identifiers (`domain`, `companyName`).",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"searchResultIds\": [\n    \"cmp_sr_01J8YQ4FXZQ6N5G2T3A7BC9D1E\"\n  ],\n  \"companies\": [\n    {\n      \"domain\": \"seamless.ai\",\n      \"companyName\": \"Seamless.AI\"\n    }\n  ],\n  \"skipDeduplicationCheck\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Poll Company Research",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Token",
            "value": "{{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/companies/research/poll",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "companies",
            "research",
            "poll"
          ],
          "query": [
            {
              "key": "requestIds",
              "value": "1,2,3,4,5",
              "description": "One or more research request IDs returned from `/companies/research`."
            }
          ]
        },
        "description": "Get the results/status of a company research"
      }
    }
  ]
}